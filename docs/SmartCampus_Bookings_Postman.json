							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"REJECTED\"\n}"
						}
					}
				},
				{
					"name": "DELETE – Delete Booking (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Deletion confirmed', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body.message).to.include('deleted');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"url": "{{base_url}}/bookings/{{booking_id}}",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				}
			]
		},

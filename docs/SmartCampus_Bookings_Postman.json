									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Status is REJECTED', () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b.status).to.eql('REJECTED');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"url": "{{base_url}}/bookings/{{booking_id}}/status",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"REJECTED\",\n  \"reason\": \"Facility is reserved for maintenance on this date.\"\n}"
						}
					}
				},
				{
					"name": "PATCH – Reject Without Reason (should fail)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 400 – reason required', () => {",
									"  pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"url": "{{base_url}}/bookings/{{booking_id}}/status",

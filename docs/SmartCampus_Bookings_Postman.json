{
	"info": {
		"name": "Smart Campus – Module B: Booking Management",
		"description": "Complete Postman collection for IT3030 PAF Assignment – Booking Management endpoints.\n\nSetup:\n1. Set `base_url` variable to `http://localhost:8081/api`\n2. Run 'Login (Get Token)' first, the token is auto-saved\n3. All other requests use the saved token automatically",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8081/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "booking_id",
			"value": ""
		},
		{
			"key": "facility_id",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login (Get Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) {",
									"  pm.collectionVariables.set('token', res.token);",
									"  console.log('Token saved:', res.token);",
									"}",
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Token returned', () => pm.expect(res.token).to.exist);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/auth/login",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@smartcampus.edu\",\n  \"password\": \"password123\"\n}"
						}
					}
				},
				{
					"name": "Login as Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) pm.collectionVariables.set('token', res.token);",
									"pm.test('Status 200', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/auth/login",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@smartcampus.edu\",\n  \"password\": \"admin123\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "Bookings – User",
			"item": [
				{
					"name": "POST – Create Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
									"pm.test('Status is PENDING', () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b.status).to.eql('PENDING');",
									"});",
									"pm.test('Has booking ID', () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b.id).to.exist;",
									"  pm.collectionVariables.set('booking_id', b.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/bookings",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"facilityId\": \"{{facility_id}}\",\n  \"date\": \"2026-05-15\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"purpose\": \"Team sprint planning meeting\",\n  \"expectedAttendees\": 8\n}"
						}
					}
				},
				{
					"name": "POST – Create Booking (Validation Fail – short purpose)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
									"pm.test('Has validation error', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body.errors || body.message).to.exist;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/bookings",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"facilityId\": \"{{facility_id}}\",\n  \"date\": \"2026-05-15\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"purpose\": \"Hi\"\n}"
						}
					}
				},
				{
					"name": "GET – My Bookings",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/bookings/my",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				},
				{
					"name": "GET – My Bookings (Filter PENDING)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('All PENDING', () => {",
									"  const bookings = pm.response.json();",
									"  bookings.forEach(b => pm.expect(b.status).to.eql('PENDING'));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/bookings/my?status=PENDING",
							"query": [
								{
									"key": "status",
									"value": "PENDING"
								}
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				},
				{
					"name": "GET – Single Booking by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Correct booking ID', () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b.id).to.eql(pm.collectionVariables.get('booking_id'));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/bookings/{{booking_id}}",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				},
				{
					"name": "GET – Check Conflict (Available)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Response has hasConflict field', () => {",
									"  const body = pm.response.json();",
									"  pm.expect(body.hasConflict).to.be.a('boolean');",
									"  pm.expect(body.available).to.be.a('boolean');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/bookings/check-conflict?facilityId={{facility_id}}&date=2026-06-01&startTime=14:00&endTime=16:00",
							"query": [
								{
									"key": "facilityId",
									"value": "{{facility_id}}"
								},
								{
									"key": "date",
									"value": "2026-06-01"
								},
								{
									"key": "startTime",
									"value": "14:00"
								},
								{
									"key": "endTime",
									"value": "16:00"
								}
							]
						},
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				},
				{
					"name": "PATCH – Cancel Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Status is CANCELLED', () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b.status).to.eql('CANCELLED');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"url": "{{base_url}}/bookings/{{booking_id}}/cancel",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						]
					}
				}
			]
		},
